{
  "name": "neo4j-api",
  "version": "1.0.0",
  "description": "Neo4j Graphql API",
  "type": "module",
  "main": "dist/index.js",
  "private": false,
  "scripts": {
    "predev": "tsc",
    "dev": "pnpm run \"/dev:/\"",
    "dev:tsc": "tsc --watch --preserveWatchOutput",
    "dev:node": "node --env-file=.env --enable-source-maps --inspect --watch dist/index.js",
    "start": "node dist/index.js",
    "build": "tsc",
    "rebuild-schema": "tsx --env-file=.env src/rebuild-schema.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.10.2",
    "@graphql-tools/load-files": "^7.0.0",
    "@neo4j/graphql": "^5.3.2",
    "graphql": "^16.8.1",
    "neo4j-driver": "^5.19.0"
  },
  "devDependencies": {
    "@neo4j/introspector": "^3.0.0",
    "@types/node": "^20.12.4",
    "prettier": "^3.2.5",
    "typescript": "^5.4.4",
    "tsx": "4.20.6"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
